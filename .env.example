# =====================================================================
# AMD DEVELOPER HACKATHON ACT III - ENVIRONMENT CONFIGURATION
# =====================================================================
# Golden Rule: Never commit real API keys into code or Git repositories.
# Copy this file to .env and insert your personal credentials.

# ---------------------------------------------------------------------
# AMD DEVELOPER CLOUD / TOKENFACTORY (vLLM OpenAI-Compatible Endpoint)
# ---------------------------------------------------------------------
# Your vLLM endpoint URL deployed on AMD Instinct GPU (or tokenfactory URL)
LLM_BASE_URL=https://your-amd-vllm-endpoint.amd.com/v1

# API token for your AMD vLLM instance
LLM_API_KEY=your_amd_vllm_api_key_here

# Gemma 4 Model ID on AMD vLLM (e.g. google/gemma-4-31B-it, google/gemma-4-26B-A4B, google/gemma-4-E4B)
LLM_MODEL=google/gemma-4-31B-it

# ---------------------------------------------------------------------
# EVOLUS WORKSPACE CONFIGURATION (app.evolus.ai)
# ---------------------------------------------------------------------
# Evolus Base URL (default: https://api.evolus.ai/v1)
EVOLUS_BASE_URL=https://api.evolus.ai/v1

# Evolus API Key from your workspace settings
EVOLUS_API_KEY=your_evolus_api_key_here

# Workflow ID created in Evolus workflow builder
EVOLUS_WORKFLOW_ID=wf_inventory_promotion_agent
